  "theory": {
    "back": "← Back",
    "signalWords": "Signal words",
    "present": {
      "name": "Present Simple",
      "usage": "Habits, routines, general truths, and regular actions.",
      "signals": "always, usually, often, sometimes, never, every day, on Mondays",
      "aff": {
        "label": "Affirmative (+)",
        "structure": "I / You / We / They + V1",
        "ex1": "I work in an office.",
        "ex2": "They live in London.",
        "extra1": "He / She / It + V1+s/es",
        "extra2": "She works in a hospital.",
        "extra3": "He teaches English."
      },
      "neg": {
        "label": "Negative (−)",
        "structure": "I / You / We / They + don't + V1",
        "ex1": "I don't like coffee.",
        "ex2": "They don't speak French.",
        "extra1": "He / She / It + doesn't + V1",
        "extra2": "She doesn't work on Sundays.",
        "extra3": "He doesn't eat meat."
      },
      "ques": {
        "label": "Question (?)",
        "structure": "Do + I / you / we / they + V1 ?",
        "ex1": "Do you like pizza?",
        "ex2": "Do they live nearby?",
        "extra1": "Does + he / she / it + V1 ?",
        "extra2": "Does she speak English?",
        "extra3": "Does he work here?"
      }
    },
    "past": {
      "name": "Past Simple",
      "usage": "Completed actions, events, and states in the past.",
      "signals": "yesterday, last week, in 2020, ago, then, when",
      "aff": {
        "label": "Affirmative (+)",
        "structure": "Subject + V2 (regular: -ed / irregular)",
        "ex1": "She watched a movie yesterday.",
        "ex2": "They went to Paris last summer.",
        "extra1": "He bought a new car.",
        "extra2": "I saw a great film.",
        "extra3": "We visited our grandparents."
      },
      "neg": {
        "label": "Negative (−)",
        "structure": "Subject + didn't + V1",
        "ex1": "She didn't go to the party.",
        "ex2": "They didn't eat breakfast.",
        "extra1": "He didn't see the accident.",
        "extra2": "I didn't sleep well.",
        "extra3": "We didn't enjoy the movie."
      },
      "ques": {
        "label": "Question (?)",
        "structure": "Did + subject + V1 ?",
        "ex1": "Did you go to the party?",
        "ex2": "Did she see the doctor?",
        "extra1": "Did they eat lunch?",
        "extra2": "Did he buy a gift?",
        "extra3": "Did we miss the bus?"
      }
    },
    "future": {
      "name": "Future Simple",
      "usage": "Predictions, promises, offers, spontaneous decisions.",
      "signals": "tomorrow, next week, soon, later, in the future",
      "aff": {
        "label": "Affirmative (+)",
        "structure": "Subject + will + V1",
        "ex1": "I will call you tomorrow.",
        "ex2": "She will be here soon.",
        "extra1": "They will arrive at 8 PM.",
        "extra2": "It will rain tomorrow.",
        "extra3": "We will help you."
      },
      "neg": {
        "label": "Negative (−)",
        "structure": "Subject + won't + V1",
        "ex1": "I won't be late.",
        "ex2": "She won't come to the party.",
        "extra1": "They won't finish on time.",
        "extra2": "He won't agree with you.",
        "extra3": "We won't forget."
      },
      "ques": {
        "label": "Question (?)",
        "structure": "Will + subject + V1 ?",
        "ex1": "Will you help me?",
        "ex2": "Will she come to the party?",
        "extra1": "Will they arrive soon?",
        "extra2": "Will it rain tomorrow?",
        "extra3": "Will we be on time?"
      }
    }
  },
